{
  "name": "liveline-mobile",
  "version": "0.1.0",
  "description": "Real-time line/candle chart for React Native, backed by native Swift (LivelineKit) and Kotlin via Nitro Modules.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "nitrogen/generated",
    "ios",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "LivelineMobile.podspec",
    "react-native.config.js",
    "nitro.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen": "nitrogen"
  },
  "keywords": [
    "react-native",
    "nitro",
    "chart",
    "candlestick",
    "realtime",
    "liveline",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewiscasewell/liveline-mobile.git",
    "directory": "packages/liveline-mobile"
  },
  "homepage": "https://github.com/lewiscasewell/liveline-mobile#readme",
  "bugs": {
    "url": "https://github.com/lewiscasewell/liveline-mobile/issues"
  },
  "author": "Lewis Casewell (https://github.com/lewiscasewell)",
  "license": "MIT",
  "codegenConfig": {
    "name": "LivelineMobileSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.margelo.nitro.liveline"
    }
  },
  "devDependencies": {
    "nitrogen": "0.37.1",
    "react-native-nitro-modules": "0.37.1",
    "react": "19.2.3",
    "@types/react": "~19.2.2",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  }
}
